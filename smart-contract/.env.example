# =============================================================
# Environment variables for the Voting System Hardhat project
#
# Copy this file to `.env` and fill in your OWN values:
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# NEVER commit the real .env file. NEVER share your private key.
# =============================================================

# --- Network -------------------------------------------------
# RPC endpoint for Polygon Amoy testnet.
# The public RPC works but is rate-limited; for reliable deploys,
# create a free dedicated URL on Alchemy / Infura / QuickNode.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# --- Deployer wallet -----------------------------------------
# Private key (hex, 64 chars) of the wallet that deploys the contract.
# This wallet becomes the contract ADMIN.
# Use a TESTNET-ONLY wallet! Get free test POL: https://faucet.polygon.technology/
# ⚠️ Never use a mainnet wallet here. Never commit this value to git.
PRIVATE_KEY=

# --- Optional: contract verification --------------------------
# API key from https://polygonscan.com (My Account -> API Keys).
# Only needed if you want to verify the source code on the explorer.
POLYGONSCAN_API_KEY=